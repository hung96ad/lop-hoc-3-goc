# ==========================================
# Application Configuration
# ==========================================
ENVIRONMENT=development
PROJECT_NAME="EduAI Exam Platform"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ==========================================
# Security & JWT
# ==========================================
SECRET_KEY=change-this-super-secret-key-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ck3g_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ck3g_db
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ck3g_db

# ==========================================
# Redis & Background Workers
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==========================================
# AI Agent Configuration
# ==========================================
# Provider: "mock" (default for testing/dev offline), "openai", or "azure_openai"
AI_PROVIDER=mock
OPENAI_API_KEY=sk-test-mock-key
# Custom OpenAI Base URL (e.g., https://api.openai.com/v1, http://localhost:11434/v1, or proxy endpoint)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=60

# ==========================================
# Frontend Configuration
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
